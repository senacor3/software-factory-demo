# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Installed BMad skill packages — reconstructable from skills-lock.json
# (npx skills add bmad-code-org/BMAD-METHOD --skill <name>). Scoped to the bmad/bmod
# prefixes so it doesn't also swallow .claude/skills/software-factory-*/ — those are
# software-factory's own pipeline-agent skills (architecture's Namespace mapping), committed
# deliverables, not installed packages.
.agents/skills/
.claude/skills/bmad*
.claude/skills/bmod*

# BMad render cache — reproducible via _bmad/scripts/render_skill.py
_bmad/render/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Terraform local state and provider cache -- never committed.
# .terraform.lock.hcl is deliberately NOT listed here: Terraform's own
# convention is to commit it, pinning provider versions reproducibly
# across machines/runs.
.terraform/
*.tfstate
*.tfstate.backup

# infra/main.tf's own packaging-step outputs (unzipped build dir + deployable
# zip, from local.build_dir / archive_file's output_path) -- reproducible
# from orchestrator/ on every `terraform apply`, never deliverables.
infra/build/
infra/lambda_package.zip
