# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Installed BMad skill packages — reconstructable from skills-lock.json
# (npx skills add bmad-code-org/BMAD-METHOD --skill <name>). Scoped to the bmad/bmod
# prefixes so it doesn't also swallow .claude/skills/light-factory-*/ — those are
# light-factory's own pipeline-agent skills (architecture's Namespace mapping), committed
# deliverables, not installed packages.
.agents/skills/
.claude/skills/bmad*/
.claude/skills/bmod*/

# BMad render cache — reproducible via _bmad/scripts/render_skill.py
_bmad/render/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
